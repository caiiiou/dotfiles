# p10k instant prompt (keep near top)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
export EDITOR=nvim
export VISUAL="$EDITOR"
typeset -U path PATH
path=(/opt/homebrew/bin /opt/homebrew/sbin /usr/local/opt/Bento4/bin $path ~/.local/bin)

ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
zstyle ':omz:update' mode auto
source $ZSH/oh-my-zsh.sh

# History
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY

# fzf
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
source <(fzf --zsh)

# lsd
alias ls='lsd --icon=auto --color=auto'
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'
alias lt='ls --tree'

alias fastfetch="fastfetch --kitty-direct ~/.config/fastfetch/pngs/applejack.png --logo-width 20 --logo-padding-top 6 --logo-padding-right 10 --logo-padding-left 7"
alias kepubify="kepubify -u -i --no-preserve-dirs"

# bat as cat
export BAT_THEME=ansi BAT_STYLE=plain
alias cat='bat --paging=never'
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export MANROFFOPT='-c'

# rsgain [folder]: scans ~/Music/<folder>; bare = Liked Songs + Chill
rsgain() {
  local dirs
  (( $# )) && dirs=("$*") || dirs=("Liked Songs" "Chill")
  local d; for d in $dirs; do
    command rsgain easy --skip-existing -p ~/.config/rsgain/presets/main.ini ~/Music/$d
  done
}

# amdl [flags] <url>: Apple Music download to ~/Music/Liked Songs (--chill for ~/Music/Chill)
_amdl() { /Users/caillou/Coding/Apple-Music-Downloader/download.sh --lib "$@" }
alias amdl='noglob _amdl'

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#A499BE,bold,"
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

~/Scripts/pokemon_lucky.zsh
